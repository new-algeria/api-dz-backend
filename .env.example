# Copier en .env (jamais commité) pour `npm run dev`.
# En production : mêmes noms dans Vercel → projet → Settings → Environment Variables.
# Aucune des anciennes variables Express (JWT_SECRET, RAPIDAPI_*, COURIER_*…) n'est utilisée.

# ---------------------------------------------------------------- Supabase
# Supabase → Project Settings → API Keys
SUPABASE_URL=https://eoipoebafjebwtxetrgu.supabase.co
# Clé publique (sb_publishable_…) : lectures publiques, la RLS s'applique.
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : UNIQUEMENT pour les routes /v1/admin. Laisser vide désactive l'administration (503).
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Cloudflare R2
# Cloudflare → R2 → Overview : « Account ID » (colonne de droite)
R2_ACCOUNT_ID=
# Cloudflare → R2 → Manage API tokens → Create API token
#   Permissions : « Object Read & Write », limité au bucket ci-dessous.
#   Copier « Access Key ID » et « Secret Access Key » (affichée une seule fois).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=data-dz
# Domaine public du bucket : seules les images de web-assets/ doivent y rester accessibles.
R2_PUBLIC_URL=https://files.data-dz.com

# ---------------------------------------------------------------- API
URL_API=https://api.data-dz.com
# Origines autorisées pour /v1/admin (séparées par des virgules).
ORIGINES_ADMIN=https://data-dz.com,https://www.data-dz.com,http://localhost:5173
# Jeton du script de synchronisation GeoAlgeria (Authorization: Bearer …), 32 caractères minimum.
# Générer : openssl rand -base64 48
CLE_SYNCHRO=

# ---------------------------------------------------------------- Limite de débit (facultatif)
# Upstash Redis (Vercel → Storage / Marketplace → Upstash). Les noms KV_REST_API_URL / KV_REST_API_TOKEN
# posés par l'intégration Vercel sont aussi reconnus. Sans Redis : limite en mémoire, par instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
